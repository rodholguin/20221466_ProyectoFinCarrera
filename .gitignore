# Datos (no versionar archivos grandes; solo se versionan los .gitkeep)
data/raw/*.parquet
data/raw/*.csv
data/interim/*.parquet
data/interim/*.csv
data/processed/*.parquet
data/processed/*.csv

# Cache de respuestas crudas del SMV (archivos JSON grandes ~8MB c/u)
data/raw/smv_cache/
# PDFs del Informe Bursátil Mensual de la BVL (~187 MB, 174 archivos).
# Se regeneran con scripts/gen_bvl_mensual.py (URL predecible, ver bvl_infmen.py)
data/raw/bvl_infmen/
# Logs de corridas largas
data/interim/*.log
# Archivos de exploración/sondeo (generados por scripts de probe)
data/interim/smv_*.json
data/interim/smv_*.txt

# Cache de respuestas del LLM de sentimiento. NO se versiona: son ~50 MB de
# respuestas regenerables, y el patron anterior (sentiment_cache*.json) NO cubria
# el directorio porque `*` no cruza `/`. Reproducir una corrida no necesita el
# cache: necesita el corpus (data/raw/news_*.parquet) y el prompt versionado.
data/interim/sentiment_cache/
data/interim/sentiment_cache*.json

# Artefactos ARCHIVADOS al cambiar de version/universo. Se conservan en disco
# por trazabilidad local, no en el repo.
data/interim/_sentimiento_viejo_*/
data/interim/_macro_bcrp_con_oro_*.parquet
data/raw/_corpus_viejo_*/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Entornos virtuales
# Anclados a la RAÍZ a propósito: sin la barra inicial, `env/` también se traga
# `src/env/` (el entorno de RL de OE1) y el paquete desaparece del repo sin que
# nada falle. Pasó el 2026-09-03.
/.venv/
/venv/
/env/
/ENV/

# Variables de entorno / secretos
.env
.env.*
*.env

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints/

# Distribución / build
dist/
build/
*.egg-info/

# macOS
.DS_Store

# Windows
Thumbs.db

# Artefactos de caché creados al ejecutar notebooks con otro cwd
notebooks/data/

# Extracciones del terminal Bloomberg (data licenciada, NO redistribuible).
# Anclado con `data/raw/` explícito, no con un patrón suelto: ver la nota de
# los entornos virtuales más arriba. Citar como "Bloomberg L.P., consultado el
# 2026-09-05 y 2026-09-07". Ver docs/estado_extraccion_bloomberg.txt
data/raw/bloomberg/

# Artefactos precalculados que alimentan notebooks/OE1_entorno_y_agente.ipynb.
# Son regenerables con scripts/genera_artefactos_oe1.py (~10 min) y pesan ~1 MB
# entre el .npz de curvas y los .json. El notebook SI se versiona con sus
# salidas: es el entregable. OJO: data/interim/registro_configuraciones.jsonl NO
# entra aca — es la bitacora append-only de D10 y tiene que ser versionable.
data/interim/artefactos_oe1/

# Respaldo del panel ANTERIOR al fix de fecha del 2026-09-12 (~15 MB de parquets).
# Se conserva en disco por trazabilidad —la convencion del proyecto es que nada
# se borra— pero no entra al repo: es data derivada y regenerable. El hallazgo y
# su validacion viven en docs/hallazgos_desfase_fecha_bvl.txt.
data/interim/_respaldo_pre_fix_fecha/

# Archivos de bloqueo de Office (se crean al abrir un .pptx/.docx y desaparecen
# al cerrarlo). Nunca deben commitearse.
~$*
